# Garnavo backend environment — copy to .env and fill in real values.

# --- Database (required) ---
MONGO_URL=mongodb://localhost:27017
DB_NAME=garnavo

# --- Admin / auth ---
JWT_SECRET=generate-a-long-random-string
ADMIN_EMAIL=admin@garnavo.com
ADMIN_PASSWORD=change-me

# --- PayPal (required for live payments) ---
# Create a REST app at https://developer.paypal.com/dashboard → Apps & Credentials
# Use LIVE credentials + PAYPAL_MODE=live in production.
PAYPAL_MODE=live
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# --- Email (Resend) ---
RESEND_API_KEY=
SENDER_EMAIL=orders@garnavo.com

# --- Store ---
STORE_NAME=Garnavo
STORE_URL=https://garnavo.com
STORE_NOTIFICATION_EMAIL=you@example.com

# --- Dev only: enables /simulate-payment (marks orders paid with no
# --- real charge). NEVER set to true in production.
# ALLOW_SIMULATE_PAYMENT=false
